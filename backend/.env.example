# ==== Cấu hình Crypto Planet Backend ====
# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# Cổng chạy API
PORT=5000

# MongoDB Local (KHÔNG dùng Atlas theo yêu cầu dự án)
MONGODB_URI=mongodb://127.0.0.1:27017/crypto_planet

# Bí mật JWT — sinh ngẫu nhiên, tối thiểu 32 ký tự, KHÔNG chia sẻ
JWT_SECRET=cp_9f4b2a7e8d1c6b3a5e7d9c1f3b5a7e9d2c4f6b8a0e2d4c6f8b0a2e4d6c8f1a3e5
JWT_EXPIRES_IN=7d

# bcrypt (bcryptjs) — số vòng hash
BCRYPT_SALT_ROUNDS=10

# Phí giao dịch tính theo % giá trị lệnh (đã chốt: 0.5%)
TRADE_FEE_PERCENT=0.5

# Hạn mức nạp/rút tối thiểu (VND)
MIN_DEPOSIT_VND=50000
MIN_WITHDRAWAL_VND=50000

# URL frontend (CORS)
CLIENT_URL=http://localhost:5173

# Tài khoản quản trị viên — dùng bởi script seed
ADMIN_EMAIL=admin@cryptoplanet.vn
ADMIN_PASSWORD=Admin@123

# development | production
NODE_ENV=development
